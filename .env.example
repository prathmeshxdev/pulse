# Copy to .env. Used by docker-compose and the Go tools (via CLICKHOUSE_DSN).

# --- ClickHouse Cloud ---
# Native secure port is 9440. Format:
#   clickhouse://<user>:<password>@<host>:9440/sony_liv?secure=true
CLICKHOUSE_DSN=clickhouse://default:PASSWORD@your-instance.clickhouse.cloud:9440/sony_liv?secure=true

# --- API server ---
ADDR=:8080
REDIS_ADDR=localhost:6379
# Set false to run without Redis (the preflight singleflight cache is optional).
PREFLIGHT_ENABLED=true
# Identical queries are served from cache for this long. 1m default; drop to a
# few seconds for a live-ingest demo so fresh data shows up quickly.
PREFLIGHT_CACHE_TTL=1m

# --- ClickStack observability (OTLP → ClickHouse Cloud) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- LibreChat + ClickHouse MCP (optional) ---
# Generated by clickhouse/scripts/sync_librechat_env.sh from CLICKHOUSE_DSN.
# LIBRECHAT_CH_HOST=your-instance.clickhouse.cloud
# LIBRECHAT_CH_PORT=8443
# LIBRECHAT_CH_USER=pulse_readonly
# LIBRECHAT_CH_PASSWORD=Pulse_ro_demo_2026
# LIBRECHAT_CH_SECURE=true
# LIBRECHAT_CH_DATABASE=sony_liv

# --- LibreChat LLM (local .env only — do NOT commit org URLs or keys) ---
# LITELLM_UPSTREAM_URL=https://your-org-litellm-host/v1
# LITELLM_BASE_URL=https://your-org-litellm-host/v1
# ANTHROPIC_API_KEY=

# --- Langfuse LLM tracing (optional — Cloud recommended) ---
# https://cloud.langfuse.com → Project Settings → API Keys
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Frontend dev proxy target (npm run dev) ---
VITE_API_TARGET=http://localhost:8080
