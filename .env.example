# Copy to .env. Used by docker-compose and the Go tools (via CLICKHOUSE_DSN).

# --- ClickHouse Cloud ---
# Native secure port is 9440. Format:
#   clickhouse://<user>:<password>@<host>:9440/sony_liv?secure=true
CLICKHOUSE_DSN=clickhouse://default:PASSWORD@your-instance.clickhouse.cloud:9440/sony_liv?secure=true

# --- API server ---
ADDR=:8080
REDIS_ADDR=localhost:6379
# Set false to run without Redis (the preflight singleflight cache is optional).
PREFLIGHT_ENABLED=true

# --- Frontend dev proxy target (npm run dev) ---
VITE_API_TARGET=http://localhost:8080
