# Copy to .env and fill in. Used by docker-compose in this directory.

# --- ClickHouse Cloud (serving layer) ---
# Use a READ-ONLY ClickHouse user for the MCP server (see README).
CH_HOST=your-instance.clickhouse.cloud
CH_PORT=8443
CH_USER=pulse_readonly
CH_PASSWORD=change-me
CH_SECURE=true
CH_DATABASE=sony_liv

# --- LLM provider (at least one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
