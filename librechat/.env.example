# Copy to .env and fill in. Used by docker-compose in this directory.

# --- ClickHouse Cloud (serving layer) ---
# Use the READ-ONLY user (clickhouse/scripts/create_readonly_user.sql) — verified
# to allow SELECT on the serving layer and DENY raw_events + writes.
CH_HOST=your-instance.clickhouse.cloud
CH_PORT=8443
CH_USER=pulse_readonly
CH_PASSWORD=Pulse_ro_demo_2026
CH_SECURE=true
CH_DATABASE=sony_liv

# --- LLM provider (at least one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
